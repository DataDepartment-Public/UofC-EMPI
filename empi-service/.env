# Local eMPI config overrides (see .env.example for all keys).

# ── ML matcher (Stage 4.5) ───────────────────────────────────────────────────
# Stage 4.25's non-match gate discards the confident non-matches, so Stage 4.5
# is a 2-tier classifier: confident match (auto_merge) vs ambiguous
# (human_review). It has no floor and never drops a pair — below the threshold
# a pair goes to a reviewer.
#
# This matches src/config.py's default; it is set explicitly here so the
# operating point is visible where you'd look for it.
EMPI_ML_AUTO_MERGE_THRESHOLD=0.90
EMPI_GATE_THRESHOLD=0.30