# Local eMPI config overrides (see .env.example for all keys).

# ── ML matcher (Stage 4.5) ───────────────────────────────────────────────────
# The FS matcher (Stage 4) gates the ML input pool — it discards the confident
# non-matches (its no_match tier) so the ML matcher only ever sees plausible
# pairs. The ML matcher is therefore a 2-tier classifier: confident match
# (auto_merge) vs ambiguous (human_review), with NO no_match tier.
#
# review_floor = 0.0 removes the no_match tier (every score >= 0 is at least
# human_review). Single decision threshold: confident match at score >= 0.70,
# matching the v3 notebook (ambiguous at P(ambiguous) >= 0.30).
EMPI_ML_AUTO_MERGE_THRESHOLD=0.70
EMPI_ML_REVIEW_FLOOR=0.0
