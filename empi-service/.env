# Local eMPI config overrides (see .env.example for all keys).

# ── ML matcher (Stage 4.5) ───────────────────────────────────────────────────
# Match the v3 notebook operating point: ambiguous at P(ambiguous) >= 0.30,
# i.e. confident match at score = 1 - P(ambiguous) >= 0.70.
EMPI_ML_AUTO_MERGE_THRESHOLD=0.70
