# eMPI pipeline configuration. Copy to `.env` and edit; every key is optional
# and falls back to the default in src/config/config.py. All keys are read via
# pydantic-settings with the EMPI_ prefix.

# ── Logging (src/logging_config.py) ──────────────────────────────────────────
# Root log level: DEBUG / INFO / WARNING / ERROR / CRITICAL.
EMPI_LOG_LEVEL=INFO
# Also write logs to a file under EMPI_LOG_DIR (true/false).
EMPI_LOG_TO_FILE=false
# Directory for the log file (default: ./logs).
EMPI_LOG_DIR=logs
# Log filename under EMPI_LOG_DIR (default: empi_<UTC-date>.log).
# EMPI_LOG_FILE=empi.log

# ── Blocking governance ──────────────────────────────────────────────────────
# EMPI_GOVERNANCE_THRESHOLD=500

# ── Rules ────────────────────────────────────────────────────────────────────
# EMPI_SSN_FANOUT_THRESHOLD=4

# ── Deployment report (src/evaluation/deployment.py) ─────────────────────────
# EMPI_DEPLOY_BLOCKING_METHOD=loose   # loose | sample
# EMPI_DEPLOY_BLOCKING_SAMPLE=500
# EMPI_DEPLOY_SEED=7

# ── Rule-eval adjudication (src/evaluation/rule_eval.py) ─────────────────────
# EMPI_ADJ_SAMPLE_SIZE=300

# ── Non-match gate (Stage 4.25, src/models/nonmatch_gate/) ───────────────────
# The gate filters the ML input pool: it scores every non_matches pair with
# P(plausible) and discards everything below the threshold as a confident
# non-match, so the ML matcher only ever sees plausible pairs. 0.30 is the
# notebook's operating point (0.999 held-out plausible recall). A dropped pair
# is unrecoverable downstream, so favor recall when tuning this.
# EMPI_GATE_THRESHOLD=0.30
# A retrained gate may only be promoted if its held-out plausible
# precision/recall stay within this margin of the active model's.
# EMPI_GATE_DEPLOY_GATE_MARGIN=0.02
# Set false to put the LEGACY FS gate (EMPI_FS_REVIEW_FLOOR) back in the gate
# seat — e.g. for a head-to-head comparison run. FS is otherwise audit-only.
# EMPI_GATE_SUPERSEDES_FS=true

# ── Per-pair SHAP explanations (src/models/explanations.py) ──────────────────
# The gate and the ML matcher each emit a per-pair contribution frame next to
# their scores, served by GET /explanations/... . Computed at score time so an
# explanation always describes the model that made the recorded decision.
# ~20us and ~75 bytes per pair per model.
# EMPI_EXPLANATIONS_ENABLED=true
# How many features the endpoint suggests showing in a waterfall (a hint; all
# are always returned, ranked by |contribution|).
# EMPI_EXPLANATION_TOP_N=8

# ── ML matcher (Stage 4.5, src/models/ml_matcher/) ───────────────────────────
# Because the gate (above) removes the confident non-matches upstream, the ML
# matcher is a 2-tier classifier — confident match (auto_merge) vs ambiguous
# (human_review).
#
# The served LightGBM v3 model scores P(confident match) = 1 - P(ambiguous).
# The v3 notebook flags ambiguous at P(ambiguous) >= 0.30, i.e. a confident
# match at score >= 0.70 — mirror that operating point here (default 0.95).
EMPI_ML_AUTO_MERGE_THRESHOLD=0.70
# Keep OFF: audit-only. The gate makes the ML auto_merge tier more
# defensible, but validate before unioning it into clustering.
# EMPI_ML_FEEDS_CLUSTERING=true   # default ON — Stage 4.5 forms merge edges.
# Set false for deterministic-edges-only clustering (and for a leakage-free
# gold headline at --holdout none).

# ── API read guards (src/api/routers/cluster_pairs.py) ───────────────────────
# Largest cluster GET /clusters/{mid}/pairs will trace pairwise. That view
# enumerates every unordered pair of members and then walks the merge graph
# for the ones that formed no edge of their own, so its cost grows faster
# than n^2 — a several-hundred-member hub cluster (one common name plus a
# shared DOB) would spend minutes of blocking CPU on a single GET. Above this,
# the route returns members + external_pairs with pairs_truncated=true.
# EMPI_CLUSTER_PAIRS_MAX_MEMBERS=200
