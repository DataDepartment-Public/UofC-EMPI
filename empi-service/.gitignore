# Environment
.env
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data files (keep structure, ignore data)
data/raw/*
data/processed/*
data/blocking/*
data/matches/*
data/non_matches/*
data/rejects/*
data/clusters/*
data/runs/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/blocking/.gitkeep
!data/matches/.gitkeep
!data/non_matches/.gitkeep
!data/rejects/.gitkeep
!data/clusters/.gitkeep
!data/runs/.gitkeep
*.csv
*.parquet
*.pkl
*.pickle
*.xlsx
*.xls
# empi.db (src/api/) — the resolved-output DB is runtime state, not source.
*.db

# Logs
logs/*
!logs/.gitkeep
*.log

# Model artifacts
models/artifacts/*
models/experiments/*
!models/artifacts/.gitkeep
!models/experiments/.gitkeep
*.joblib
*.h5
*.pkl

# FS matcher model store (trained Splink JSON + .meta.json + active.json) —
# produced on the VM by `python -m src.models.fs_matcher.train`; runtime, not source.
models/fs/*
!models/fs/.gitkeep

# FS matcher outputs — GBT feature parquet (data/FS_output) + the
# ProbabilisticMatches audit frame (data/matches_model). (Parquet is already
# globally ignored; keep the dirs on a fresh clone via .gitkeep.)
data/FS_output/*
!data/FS_output/.gitkeep
data/matches_model/*
!data/matches_model/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Claude
.claude/
CLAUDE.md
